{
  "name": "the-wire",
  "version": "1.0.0",
  "description": "The Wire - A globally distributed social network on Cloudflare edge",
  "type": "module",
  "scripts": {
    "dev": "npx vite build && wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.config.integration.ts",
    "test:api": "vitest run --config vitest.config.api.ts",
    "test:api:watch": "vitest --config vitest.config.api.ts",
    "test:api:coverage": "vitest run --config vitest.config.api.ts --coverage",
    "test:scale": "vitest run tests/scale/",
    "test:load": "tsx tests/scale/load-harness.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.80.7",
    "hono": "^4.6.0",
    "jose": "^5.9.0",
    "lucide-react": "^0.562.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.1",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.5.0",
    "@cloudflare/workers-types": "^4.20241127.0",
    "@playwright/test": "^1.57.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "eslint": "^9.16.0",
    "prettier": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.0",
    "wrangler": "^4.56.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
